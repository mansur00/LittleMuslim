  "prayer.other.sunnah.rakat": "Esempio: 2 prima di Fajr; 2 prima/dopo altri Fard",
  "@prayer.other.sunnah.rakat": {
    "description": "উদাহরণ: ফজরের আগে ২; কিছু ফরজের আগে/পরে ২ রাকাত (prayer.other.sunnah.rakat)"
  },
  "prayer.other.sunnah.time": "Prima o dopo la relativa preghiera obbligatoria",
  "@prayer.other.sunnah.time": {
    "description": "সংশ্লিষ্ট ফরজের আগে বা পরে (prayer.other.sunnah.time)"
  },
  "prayer.other.sunnah.note": "Il numero delle Sunnah enfatizzate varia tra le scuole. Segui il tuo insegnante.",
  "@prayer.other.sunnah.note": {
    "description": "সুন্নত নামাজের সংখ্যা ও জোরালো/কম জোরালো শ্রেণিতে মাযহাবভেদে পার্থক্য আছে। পরিবারের শিক্ষক বা স্থানীয় ইমামের শেখানো নিয়ম অনুসরণ করো। (prayer.other.sunnah.note)"
  },
  "prayer.other.sunnah.virtue": "Una casa in Paradiso è promessa a chi compie 12 rakat di Sunnah volontarie al giorno.",
  "@prayer.other.sunnah.virtue": {
    "description": "প্রতিদিন ফরজের বাইরে ১২ রাকাত সুন্নত পড়ার জন্য জান্নাতে ঘরের সুসংবাদ এসেছে। (prayer.other.sunnah.virtue)"
  },
  "prayer.other.sunnah.reference": "Sahih Muslim 728c",
  "@prayer.other.sunnah.reference": {
    "description": "সহিহ মুসলিম ৭২৮c (prayer.other.sunnah.reference)"
  },
  "prayer.other.witr.title": "Witr",
  "@prayer.other.witr.title": {
    "description": "বিতর (prayer.other.witr.title)"
  },
  "prayer.other.witr.subtitle": "Rakat dispari dopo Isha",
  "@prayer.other.witr.subtitle": {
    "description": "ইশার পর বিজোড় রাকাত (prayer.other.witr.subtitle)"
  },
  "prayer.other.witr.rakat": "Rakat dispari; 1 o 3 rakat secondo la scuola",
  "@prayer.other.witr.rakat": {
    "description": "বিজোড় রাকাত; ১ বা ৩-সহ পদ্ধতিতে মতভেদ আছে (prayer.other.witr.rakat)"
  },
  "prayer.other.witr.time": "Dopo Isha fino a prima di Fajr",
  "@prayer.other.witr.time": {
    "description": "ইশার পর থেকে ফজরের আগে (prayer.other.witr.time)"
  },
  "prayer.other.witr.note": "La modalità e il numero di rakat di Witr hanno leggere differenze. Segui la tua scuola.",
  "@prayer.other.witr.note": {
    "description": "বিতর কীভাবে ও কয় রাকাত পড়তে হয়—এ বিষয়ে মাযহাবভেদে কিছু পার্থক্য রয়েছে। নিজের শেখা পদ্ধতিতে আদায় করো। (prayer.other.witr.note)"
  },
  "prayer.other.witr.rule": "Prega un numero dispari di rakat dopo Isha; impara la Du'a Qunut dal tuo maestro.",
  "@prayer.other.witr.rule": {
    "description": "ইশার পর বিজোড় রাকাত আদায় করো; কুনুত ও রাকাতের নিয়ম তোমার মাযহাবের শিক্ষক/ইমামের কাছ থেকে শিখে নাও। (prayer.other.witr.rule)"
  },
  "prayer.other.witr.virtue": "Il Witr è una preghiera dispari; il Profeta ﷺ ha fortemente incoraggiato a compierla.",
  "@prayer.other.witr.virtue": {
    "description": "বিতর বিজোড় রাকাতের নামাজ; রাসুল ﷺ এটি আদায়ে উৎসাহ দিয়েছেন। (prayer.other.witr.virtue)"
  },
  "prayer.other.tahajjud.title": "Tahajjud",
  "@prayer.other.tahajjud.title": {
    "description": "তাহাজ্জুদ (prayer.other.tahajjud.title)"
  },
  "prayer.other.tahajjud.subtitle": "Preghiera notturna volontaria",
  "@prayer.other.tahajjud.subtitle": {
    "description": "রাতের নফল নামাজ (prayer.other.tahajjud.subtitle)"
  },
  "prayer.other.tahajjud.rakat": "Pregata a coppie di 2 rakat; nessun totale fisso",
  "@prayer.other.tahajjud.rakat": {
    "description": "২ রাকাত করে পড়া যায়; নির্দিষ্ট মোট সংখ্যা নেই (prayer.other.tahajjud.rakat)"
  },
  "prayer.other.tahajjud.time": "Dopo essersi svegliati dal sonno dopo Isha, prima di Fajr",
  "@prayer.other.tahajjud.time": {
    "description": "ইশার পর ঘুম থেকে উঠে, ফজরের আগে (prayer.other.tahajjud.time)"
  },
  "prayer.other.tahajjud.note": "È preferibile compierla nell'ultimo terzo della notte.",
  "@prayer.other.tahajjud.note": {
    "description": "রাতের শেষ ভাগে পড়া উত্তম। ক্লান্ত হলে অল্প পড়ো; নিয়ম শেখার জন্য অভিভাবককে জিজ্ঞেস করো। (prayer.other.tahajjud.note)"
  },
  "prayer.other.tahajjud.rule": "Generalmente si prega a gruppi di 2 rakat. Concludi la notte con il Witr.",
  "@prayer.other.tahajjud.rule": {
    "description": "সাধারণভাবে ২ রাকাত করে পড়া হয়। রাতের নামাজ শেষে বিতর আদায়ের নিয়ম শিখে নাও। (prayer.other.tahajjud.rule)"
  },
  "prayer.other.tahajjud.virtue": "La preghiera notturna è considerata la migliore preghiera volontaria dopo i Fard.",
  "@prayer.other.tahajjud.virtue": {
    "description": "ফরজের পর রাতের নামাজকে উত্তম নফল নামাজ বলা হয়েছে। (prayer.other.tahajjud.virtue)"
  },
  "prayer.other.tahajjud.reference": "Sahih Muslim 1163b",
  "@prayer.other.tahajjud.reference": {
    "description": "সহিহ মুসলিম ১১৬৩b (prayer.other.tahajjud.reference)"
  },
  "prayer.other.ishraq.title": "Ishraq",
  "@prayer.other.ishraq.title": {
    "description": "ইশরাক (prayer.other.ishraq.title)"
  },
  "prayer.other.ishraq.subtitle": "Volontaria post-alba",
  "@prayer.other.ishraq.subtitle": {
    "description": "সূর্য ওঠার পর নফল (prayer.other.ishraq.subtitle)"
  },
  "prayer.other.ishraq.rakat": "Generalmente inizia con 2 Rakat",
  "@prayer.other.ishraq.rakat": {
    "description": "সাধারণত ২ রাকাত দিয়ে শুরু (prayer.other.ishraq.rakat)"
  },
  "prayer.other.ishraq.time": "Dopo il passaggio del divieto del sorgere del sole; prima di Dhuhr",
  "@prayer.other.ishraq.time": {
    "description": "সূর্য ওঠার নিষিদ্ধ সময় পার হওয়ার পর; যোহরের আগে (prayer.other.ishraq.time)"
  },
  "prayer.other.ishraq.note": "Non pregare proprio mentre il sole sorge. Attendi 15-20 minuti dopo l'alba locale.",
  "@prayer.other.ishraq.note": {
    "description": "সূর্য ওঠার পরপর নামাজ পড়া হয় না। সূর্য কিছুটা ওপরে উঠলে—স্থানীয় সূর্যোদয়ের প্রায় ১৫–২০ মিনিট পর—সময় শুরু হয়; নির্দিষ্ট ব্যবধান শহর/মৌসুমে যাচাই করো। (prayer.other.ishraq.note)"
  },
  "prayer.other.ishraq.rule": "Compi 2 rakat come le preghiere volontarie, evitando i tempi proibiti.",
  "@prayer.other.ishraq.rule": {
    "description": "সময় হওয়ার পর সাধারণ নফল নামাজের মতো ২ রাকাত পড়ো; সূর্য ওঠার নিষিদ্ধ সময় এড়িয়ে চলো। (prayer.other.ishraq.rule)"
  },
  "prayer.other.ishraq.virtue": "Un'opportunità per iniziare il mattino con il ricordo di Allah e preghiere volontarie.",
  "@prayer.other.ishraq.virtue": {
    "description": "ফজরের পর আল্লাহর স্মরণ ও নফল নামাজ দিয়ে সকাল শুরু করার সুযোগ। (prayer.other.ishraq.virtue)"
  },
  "prayer.other.duha.title": "Duha / Chasht",
  "@prayer.other.duha.title": {
    "description": "দুহা / চাশত (prayer.other.duha.title)"
  },
  "prayer.other.duha.subtitle": "Preghiera di metà mattina",
  "@prayer.other.duha.subtitle": {
    "description": "সকালের নফল নামাজ (prayer.other.duha.subtitle)"
  },
  "prayer.other.duha.rakat": "Minimo 2 Rakat; si possono pregare più coppie",
  "@prayer.other.duha.rakat": {
    "description": "কমপক্ষে ২ রাকাত; একাধিক রাকাত পড়া যায় (prayer.other.duha.rakat)"
  },
  "prayer.other.duha.time": "Dalla tarda mattinata fino a prima di Dhuhr",
  "@prayer.other.duha.time": {
    "description": "সূর্য ওপরে ওঠার পর থেকে যোহরের আগে (prayer.other.duha.time)"
  },
  "prayer.other.duha.note": "L'Ishraq è spesso considerato la parte iniziale della preghiera di Duha.",
  "@prayer.other.duha.note": {
    "description": "ইশরাককে অনেক জায়গায় দুহার প্রথম দিকের নামাজ বলা হয়। নাম ও সময় গণনায় প্রচলিত ব্যাখ্যা ভিন্ন হতে পারে। (prayer.other.duha.note)"
  },
  "prayer.other.duha.rule": "Prega in serie di 2 rakat secondo la tua capacità.",
  "@prayer.other.duha.rule": {
    "description": "২ রাকাত করে নফল পড়ো; কয় রাকাত পড়বে তা সামর্থ্য ও শেখা পদ্ধতি অনুযায়ী রাখো। (prayer.other.duha.rule)"
  },
  "prayer.other.duha.virtue": "Duha è un atto di devozione ben noto; si può praticare regolarmente secondo possibilità.",
  "@prayer.other.duha.virtue": {
    "description": "দুহা একটি পরিচিত নফল ইবাদত; সামর্থ্য অনুযায়ী নিয়মিত করা যায়। (prayer.other.duha.virtue)"
  },
  "prayer.other.tarawih.title": "Tarawih",
  "@prayer.other.tarawih.title": {
    "description": "তারাবিহ (prayer.other.tarawih.title)"
  },
  "prayer.other.tarawih.subtitle": "Preghiera notturna di Ramadan",
  "@prayer.other.tarawih.subtitle": {
    "description": "রমজানের রাতের নামাজ (prayer.other.tarawih.subtitle)"
  },
  "prayer.other.tarawih.rakat": "Il numero di rakat varia secondo le tradizioni riconosciute (8/20)",
  "@prayer.other.tarawih.rakat": {
    "description": "রাকাত সংখ্যায় প্রচলিত পদ্ধতিগুলো ভিন্ন (prayer.other.tarawih.rakat)"
  },
  "prayer.other.tarawih.time": "Dopo Isha durante il Ramadan",
  "@prayer.other.tarawih.time": {
    "description": "রমজানে ইশার পর (prayer.other.tarawih.time)"
  },
  "prayer.other.tarawih.note": "Il Tarawih può essere pregato in congregazione o individualmente.",
  "@prayer.other.tarawih.note": {
    "description": "তারাবিহ জামাতে বা একা পড়া যায়। ৮/২০ রাকাতসহ বিভিন্ন স্বীকৃত পদ্ধতি আছে—নিজের মসজিদ/শিক্ষকের অনুসরণ করো। (prayer.other.tarawih.note)"
  },
  "prayer.other.tarawih.rule": "Si compie a intervalli di 2 rakat dopo Isha durante il Ramadan.",
  "@prayer.other.tarawih.rule": {
    "description": "রমজানে ইশার পর ২ রাকাত করে পড়া হয়; বিরতি ও মোট রাকাতের পদ্ধতি মসজিদ/ইমামের অনুসরণ করো। (prayer.other.tarawih.rule)"
  },
  "prayer.other.tarawih.virtue": "Vegliare in preghiera nelle notti di Ramadan con fede e speranza di ricompensa ha grande virtù.",
  "@prayer.other.tarawih.virtue": {
    "description": "ঈমান ও সওয়াবের আশায় রমজানের রাতে ইবাদত করার ফজিলত বর্ণিত হয়েছে. (prayer.other.tarawih.virtue)"
  },
  "prayer.other.tarawih.reference": "Sahih Bukhari 2008",
  "@prayer.other.tarawih.reference": {
    "description": "সহিহ বুখারি ২০০৮ (prayer.other.tarawih.reference)"
  },
  "prayer.other.jumah.title": "Preghiera del Venerdì (Jumu'ah)",
  "@prayer.other.jumah.title": {
    "description": "জুমার নামাজ (prayer.other.jumah.title)"
  },
  "prayer.other.jumah.subtitle": "Congregazione del Venerdì",
  "@prayer.other.jumah.subtitle": {
    "description": "শুক্রবারের জামাত (prayer.other.jumah.subtitle)"
  },
  "prayer.other.jumah.rakat": "2 Rakat Fard in congregazione dopo la Khutbah",
  "@prayer.other.jumah.rakat": {
    "description": "খুতবার পর জামাতে ২ রাকাত ফরজ (prayer.other.jumah.rakat)"
  },
  "prayer.other.jumah.time": "Durante l'orario di Dhuhr il Venerdì",
  "@prayer.other.jumah.time": {
    "description": "যোহরের ওয়াক্তে (prayer.other.jumah.time)"
  },
  "prayer.other.jumah.note": "Impara le condizioni e gli obblighi della preghiera del Venerdì dai maestri.",
  "@prayer.other.jumah.note": {
    "description": "জুমার শর্ত ও কার ওপর ফরজ—এসব বিষয়ে অভিভাবক বা আলেমের কাছ থেকে বয়স ও পরিস্থিতি অনুযায়ী শিখে নাও। (prayer.other.jumah.note)"
  },
  "prayer.other.jumah.rule": "Ascolta attentamente la Khutbah, poi prega 2 rakat Fard con l'Imam.",
  "@prayer.other.jumah.rule": {
    "description": "খুতবা মনোযোগ দিয়ে শোনো, তারপর জামাতে ২ রাকাত ফরজ আদায় করো। (prayer.other.jumah.rule)"
  },
  "prayer.other.jumah.virtue": "Le preghiere da un Venerdì all'altro cancellano i peccati minori, se si evitano i peccati gravi.",
  "@prayer.other.jumah.virtue": {
    "description": "জুমা থেকে পরের জুমা পর্যন্ত নামাজগুলো গুনাহ মাফের কারণ হয়—বড় গুনাহ থেকে বেঁচে থাকতে হয়। (prayer.other.jumah.virtue)"
  },
  "prayer.other.jumah.reference": "Sahih Muslim 233b",
  "@prayer.other.jumah.reference": {
    "description": "সহিহ মুসলিম ২৩৩b (prayer.other.jumah.reference)"
  },
  "prayer.other.eid.title": "Preghiera di Eid",
  "@prayer.other.eid.title": {
    "description": "ঈদের নামাজ (prayer.other.eid.title)"
  },
  "prayer.other.eid.subtitle": "Eid al-Fitr e Eid al-Adha",
  "@prayer.other.eid.subtitle": {
    "description": "ঈদুল ফিতর ও ঈদুল আজহা (prayer.other.eid.subtitle)"
  },
  "prayer.other.eid.rakat": "2 Rakat; i Takbir aggiuntivi variano per scuola",
  "@prayer.other.eid.rakat": {
    "description": "২ রাকাত; অতিরিক্ত তাকবিরের নিয়মে মতভেদ আছে (prayer.other.eid.rakat)"
  },
  "prayer.other.eid.time": "La mattina di Eid, un po' dopo il sorgere del sole",
  "@prayer.other.eid.time": {
    "description": "ঈদের সকালে, সূর্য ওঠার কিছু পর (prayer.other.eid.time)"
  },
  "prayer.other.eid.note": "Segui l'Imam per il numero e la sequenza dei Takbir aggiuntivi.",
  "@prayer.other.eid.note": {
    "description": "ঈদের নামাজের তাকবির ও পদ্ধতি মাযহাবভেদে কিছুটা আলাদা হতে পারে; জামাতের ইমামের অনুসরণ করো। (prayer.other.eid.note)"
  },
  "prayer.other.eid.rule": "Si prega in 2 rakat in congregazione con Takbir aggiuntivi assieme all'Imam.",
  "@prayer.other.eid.rule": {
    "description": "২ রাকাত জামাতে হয় এবং অতিরিক্ত তাকবির থাকে; ইমামের সঙ্গে ধাপে ধাপে পড়ো। (prayer.other.eid.rule)"
  },
  "prayer.other.eid.virtue": "La preghiera comunitaria di Eid è un atto di ringraziamento e gioia per i musulmani.",
  "@prayer.other.eid.virtue": {
    "description": "জামাতে ঈদের নামাজ মুসলিমদের আনন্দ ও কৃতজ্ঞতার ইবাদত। (prayer.other.eid.virtue)"
  },
  "prayer.other.janazah.title": "Preghiera funebre (Janazah)",
  "@prayer.other.janazah.title": {
    "description": "জানাজার নামাজ (prayer.other.janazah.title)"
  },
