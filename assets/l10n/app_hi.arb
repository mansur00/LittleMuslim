  },
  "@duas.item.enter_home.title": {
    "description": "ঘরে প্রবেশের সময় (duas.item.enter_home.title)"
  },
  "@duas.item.enter_home.meaning": {
    "description": "আল্লাহর নামে আমরা প্রবেশ করলাম, আল্লাহর নামেই বের হয়েছিলাম, আর আমাদের রব আল্লাহর ওপরই আমরা ভরসা করলাম। (duas.item.enter_home.meaning)"
  },
  "@duas.item.enter_home.reference": {
    "description": "আবু দাউদ ৫০৯৬ (duas.item.enter_home.reference)"
  },
  "@duas.item.mosque_enter.title": {
    "description": "মসজিদে প্রবেশের সময় (duas.item.mosque_enter.title)"
  },
  "@duas.item.mosque_enter.meaning": {
    "description": "আমি মহান আল্লাহর কাছে বিতাড়িত শয়তান থেকে আশ্রয় চাই। আল্লাহর নামে। হে আল্লাহ, আমার জন্য আপনার রহমতের দরজাগুলো খুলে দিন। (duas.item.mosque_enter.meaning)"
  },
  "@duas.item.mosque_enter.reference": {
    "description": "আবু দাউদ ৪৬৫ ও মুসলিম ৭১৩ (duas.item.mosque_enter.reference)"
  },
  "@duas.item.mosque_exit.title": {
    "description": "মসজিদ থেকে বের হওয়ার সময় (duas.item.mosque_exit.title)"
  },
  "@duas.item.mosque_exit.meaning": {
    "description": "আল্লাহর নামে এবং আল্লাহর রাসুলের ওপর দরুদ ও সালাম। হে আল্লাহ, আমি আপনার অনুগ্রহ ও দান প্রার্থনা করছি। হে আল্লাহ, আমাকে বিতাড়িত শয়তানের অনিষ্ট থেকে রক্ষা করুন। (duas.item.mosque_exit.meaning)"
