  },
  "prayer.fard.isha.time": "शुरू: गोधूलि छिपने पर  ·  आधी रात से पहले बेहतर",
  "@prayer.fard.isha.time": {
    "description": "শুরু: সন্ধ্যার আভা মিলালে  ·  শেষসীমা বিষয়ে মতভেদ; অর্ধরাত পার না করাই ভালো (prayer.fard.isha.time)"
  },
  "prayer.fard.isha.note": "शाम की लाली गायब होने पर इशा का समय शुरू होता है। हदीस में आधी रात तक का उल्लेख है।",
  "@prayer.fard.isha.note": {
    "description": "সন্ধ্যার আভা মিলিয়ে গেলে ইশার সময় শুরু হয়। হাদিসে মধ্যরাত পর্যন্ত সময়ের উল্লেখ আছে; মধ্যরাত বলতে সূর্যাস্ত থেকে ফজর পর্যন্ত রাতের অর্ধেক, ঘড়ির ১২টা সবসময় নয়। (prayer.fard.isha.note)"
  },
  "prayer.fard.isha.virtue": "जमात के साथ इशा और फज्र पढ़ने की विशेष फ़ज़ीलत बताई गई है।",
  "@prayer.fard.isha.virtue": {
    "description": "জামাতে ইশা ও ফজর আদায়ের বিশেষ ফজিলত বর্ণিত হয়েছে। (prayer.fard.isha.virtue)"
  },
  "prayer.fard.isha.reference": "सहीह मुस्लिम 656a",
  "@prayer.fard.isha.reference": {
    "description": "সহিহ মুসলিম ৬৫৬a (prayer.fard.isha.reference)"
  },
