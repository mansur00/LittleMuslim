  },
  "@duas.item.food_after.title": {
    "description": "খাবার শেষ করার পর (duas.item.food_after.title)"
  },
  "@duas.item.food_after.meaning": {
    "description": "সকল প্রশংসা আল্লাহর, যিনি আমাদের আহার করিয়েছেন, পান করিয়েছেন, আমাদের জন্য যথেষ্ট হয়েছেন এবং আশ্রয় দিয়েছেন। (duas.item.food_after.meaning)"
  },
  "@duas.item.food_after.reference": {
    "description": "সহিহ মুসলিম ২৭১৫ (duas.item.food_after.reference)"
  },
  "@duas.item.wudu_after.title": {
    "description": "অজু শেষ করার পর (duas.item.wudu_after.title)"
  },
  "@duas.item.wudu_after.meaning": {
    "description": "আমি সাক্ষ্য দিচ্ছি যে আল্লাহ ছাড়া কোনো সত্য ইলাহ নেই, তিনি একক, তাঁর কোনো শরিক নেই; এবং আমি সাক্ষ্য দিচ্ছি মুহাম্মদ ﷺ তাঁর বান্দা ও রাসুল। (duas.item.wudu_after.meaning)"
  },
  "@duas.item.wudu_after.reference": {
    "description": "সহিহ মুসলিম ২৩৪ (duas.item.wudu_after.reference)"
