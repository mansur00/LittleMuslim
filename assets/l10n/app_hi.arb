  },
  "@duas.item.leave_home.title": {
    "description": "ঘর থেকে বের হওয়ার সময় (duas.item.leave_home.title)"
  },
  "@duas.item.leave_home.meaning": {
    "description": "আল্লাহর নামে; আল্লাহর ওপরই ভরসা করলাম। আর আল্লাহর সাহায্য ছাড়া কোনো উপায় ও শক্তি নেই। (duas.item.leave_home.meaning)"
  },
  "@duas.item.leave_home.reference": {
