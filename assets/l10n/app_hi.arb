  "prayer.other.eid.rakat": "2 रकात; अतिरिक्त तकबीरों के नियम में मतभेद",
  "@prayer.other.eid.rakat": {
    "description": "২ রাকাত; অতিরিক্ত তাকবিরের নিয়মে মতভেদ আছে (prayer.other.eid.rakat)"
  },
  "prayer.other.eid.time": "ईद की सुबह, सूर्योदय के कुछ देर बाद",
  "@prayer.other.eid.time": {
    "description": "ঈদের সকালে, সূর্য ওঠার কিছু পর (prayer.other.eid.time)"
  },
  "prayer.other.eid.note": "अतिरिक्त तकबीरों की संख्या में इमाम का पालन करें।",
  "@prayer.other.eid.note": {
    "description": "ঈদের নামাজের তাকবির ও পদ্ধতি মাযহাবভেদে কিছুটা আলাদা হতে পারে; জামাতের ইমামের অনুসরণ করো। (prayer.other.eid.note)"
  },
  "prayer.other.eid.rule": "इमाम के साथ 2 रकात जमात में अतिरिक्त तकबीरों के साथ पढ़ी जाती है।",
  "@prayer.other.eid.rule": {
    "description": "২ রাকাত জামাতে হয় এবং অতিরিক্ত তাকবির থাকে; ইমামের সঙ্গে ধাপে ধাপে পড়ো। (prayer.other.eid.rule)"
  },
  "prayer.other.eid.virtue": "जमात में ईद की नमाज़ मुसलमानों की खुशी और कृतज्ञता की इबादत है।",
  "@prayer.other.eid.virtue": {
    "description": "জামাতে ঈদের নামাজ মুসলিমদের আনন্দ ও কৃতজ্ঞতার ইবাদত। (prayer.other.eid.virtue)"
  },
  "prayer.other.janazah.title": "जनाज़े की नमाज़",
  "@prayer.other.janazah.title": {
    "description": "জানাজার নামাজ (prayer.other.janazah.title)"
  },
  "prayer.other.janazah.subtitle": "मृतक मुस्लिम के लिए दुआ",
  "@prayer.other.janazah.subtitle": {
    "description": "মৃত মুসলিমের জন্য দোয়া (prayer.other.janazah.subtitle)"
  },
  "prayer.other.janazah.rakat": "रुकू-सजदा नहीं; सामान्य विधि में 4 तकबीर",
  "@prayer.other.janazah.rakat": {
    "description": "রুকু-সিজদা নেই; সাধারণ পদ্ধতিতে ৪ তাকবির (prayer.other.janazah.rakat)"
  },
  "prayer.other.janazah.time": "जनाज़ा तैयार होने पर जमात में",
  "@prayer.other.janazah.time": {
    "description": "জানাজা প্রস্তুত হলে জামাতে (prayer.other.janazah.time)"
  },
  "prayer.other.janazah.note": "जनाज़े की नमाज़ खड़े होकर पढ़ी जाती है। दुआएँ बड़ों से सीखें।",
  "@prayer.other.janazah.note": {
    "description": "জানাজার নামাজ দাঁড়িয়ে আদায় করা হয়। দোয়া ও তাকবিরের ধাপ কোনো বড়দের সঙ্গে শিখে নাও। (prayer.other.janazah.note)"
  },
  "prayer.other.janazah.rule": "खड़े होकर 4 तकबीरें; इसमें रुकू-सजदा नहीं है।",
  "@prayer.other.janazah.rule": {
    "description": "দাঁড়িয়ে ৪ তাকবির; এতে রুকু-সিজদা নেই। দোয়ার ধাপ অভিভাবক/ইমামের কাছে শিখে নাও। (prayer.other.janazah.rule)"
  },
  "prayer.other.janazah.virtue": "जनाज़े की नमाज़ में शामिल होने का बड़ा सवाब हदीस में बताया गया है।",
  "@prayer.other.janazah.virtue": {
    "description": "জানাজার নামাজে অংশ নেওয়ার বড় প্রতিদানের কথা হাদিসে এসেছে। (prayer.other.janazah.virtue)"
  },
