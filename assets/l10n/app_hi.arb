  "prayer.other.sunnah.subtitle": "फ़र्ज़ से पहले और बाद",
  "@prayer.other.sunnah.subtitle": {
    "description": "ফরজের আগে-পরে (prayer.other.sunnah.subtitle)"
  },
  "prayer.other.sunnah.rakat": "उदाहरण: फज्र से पहले 2; अन्य के पहले/बाद 2 रकात",
  "@prayer.other.sunnah.rakat": {
    "description": "উদাহরণ: ফজরের আগে ২; কিছু ফরজের আগে/পরে ২ রাকাত (prayer.other.sunnah.rakat)"
  },
  "prayer.other.sunnah.time": "संबंधित फ़र्ज़ से पहले या बाद में",
  "@prayer.other.sunnah.time": {
    "description": "সংশ্লিষ্ট ফরজের আগে বা পরে (prayer.other.sunnah.time)"
  },
  "prayer.other.sunnah.note": "सुन्नत नमाज़ों की संख्या में मतभेद हो सकता है। अपने शिक्षक के बताए नियमों का पालन करें।",
  "@prayer.other.sunnah.note": {
    "description": "সুন্নত নামাজের সংখ্যা ও জোরালো/কম জোরালো শ্রেণিতে মাযহাবভেদে পার্থক্য আছে। পরিবারের শিক্ষক বা স্থানীয় ইমামের শেখানো নিয়ম অনুসরণ করো। (prayer.other.sunnah.note)"
  },
  "prayer.other.sunnah.virtue": "प्रतिदिन 12 रकात सुन्नत पढ़ने वाले के लिए जन्नत में महल की खुशखबरी है।",
  "@prayer.other.sunnah.virtue": {
    "description": "প্রতিদিন ফরজের বাইরে ১২ রাকাত সুন্নত পড়ার জন্য জান্নাতে ঘরের সুসংবাদ এসেছে। (prayer.other.sunnah.virtue)"
  },
  "prayer.other.sunnah.reference": "सहीह मुस्लिम 728c",
  "@prayer.other.sunnah.reference": {
    "description": "সহিহ মুসলিম ৭২৮c (prayer.other.sunnah.reference)"
  },
  "prayer.other.witr.title": "वित्र",
